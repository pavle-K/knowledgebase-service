# Local dev config template. Copy to .env (gitignored) and fill in as needed.

# Neon/Supabase owner connection - used only by the migration runner (make migrate).
DATABASE_URL_ADMIN=postgresql://user:password@host/dbname?sslmode=require

# App-facing connections for the two roles managed by migrations/0002_roles_and_grants.sql.
# Whatever password is embedded in these URLs is what the migration sets on the role.
DATABASE_URL_RW=postgresql://app_rw:password@host/dbname?sslmode=require
DATABASE_URL_RO=postgresql://app_ro:password@host/dbname?sslmode=require

# Dedicated DB for integration tests (destructive: schema is dropped and rebuilt every run).
# Must never point at a real/production database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
APP_RW_PASSWORD=test_rw_password
APP_RO_PASSWORD=test_ro_password

# GitHub personal access token (repo read scope) - used by scripts/sync_github.py.
GITHUB_TOKEN=github_pat_your_token_here

# Embedding provider: pluggable, never hardcoded. "fake" is used in tests, no key needed.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-your_key_here

# LLM used by the query engine's synthesizer node (scripts/ask.py).
ANTHROPIC_API_KEY=sk-ant-your_key_here
LLM_MODEL=claude-haiku-4-5-20251001

# Bearer token required on every REST/MCP call except /healthz and /webhook/github.
API_AUTH_KEY=paste_generated_value_here

# Shared secret configured on the GitHub webhook - verifies X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=paste_generated_value_here
